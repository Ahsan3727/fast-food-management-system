{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@fastfood/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@fastfood/utils": ["../../packages/utils/src/index.ts"]
