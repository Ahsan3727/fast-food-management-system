# Copy this file to .env and fill in your real values
# NEVER commit .env — only .env.example is safe to commit

# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas ──────────────────────────────────────
# Get from: MongoDB Atlas → Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/fastfood_platform

# ─── JWT Secrets ────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (Upstash free tier) ────────────────────────────
# Get from: https://upstash.com → Create Database → Copy "Redis URL"
REDIS_URL=redis://default:PASSWORD@HOST.upstash.io:6379

# ─── Cloudinary (Image uploads) ─────────────────────────
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Firebase FCM (Push notifications) ───────────────────
# Get from: Firebase Console → Project Settings → Service Accounts → Generate key
# Stringify: node -e "console.log(JSON.stringify(require('./serviceAccount.json')))"
FCM_SERVICE_ACCOUNT_JSON=PASTE_STRINGIFIED_JSON_HERE

# ─── CORS Origins ────────────────────────────────────────
# Add ALL your frontend URLs (Vercel URLs after deployment)
# https://localhost is needed for Capacitor Android apps
CORS_ORIGINS=https://fastfood-customer.vercel.app,https://fastfood-rider.vercel.app,https://fastfood-admin.vercel.app,https://localhost
